# Production Environment Configuration Template
# Copy this file to .env and fill in your values

# ============================================
# Bot Configuration
# ============================================
TGBOT_TOKEN=your_bot_token_here
TGBOT_ADMIN_IDS=123456789,987654321
TGBOT_USE_REDIS=true
TGBOT_TRIGGER_MESSAGE_BUSINESS_CHAT=start
TGBOT_TRIGGER_AUTO_MESSAGE_BUSINESS_CHAT=help

# ============================================
# Database Configuration
# ============================================
# IMPORTANT: Change the default password!
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_THIS_STRONG_PASSWORD
POSTGRES_DB=restos
DATABASE_URL=postgresql+asyncpg://postgres:CHANGE_THIS_STRONG_PASSWORD@postgres:5432/restos

# Database connection pool settings
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_RECYCLE=3600

# ============================================
# Redis Configuration
# ============================================
REDIS_DSN=redis://redis:6379/0

# ============================================
# Web App Configuration
# ============================================
# Generate WEBAPP_SECRET_KEY with:
# python -c "import secrets; print(secrets.token_hex(32))"
WEBAPP_SECRET_KEY=GENERATE_A_64_CHARACTER_HEX_STRING_HERE
WEBAPP_TOKEN_EXPIRY=3600
WEBAPP_BASE_URL=https://forms.yourdomain.com
WEBAPP_API_URL=https://api.yourdomain.com

# ============================================
# CORS Configuration (CRITICAL FOR PRODUCTION!)
# ============================================
# Set to your actual domains, comma-separated
# DO NOT use "*" in production!
CORS_ORIGINS=https://yourdomain.com,https://forms.yourdomain.com,https://api.yourdomain.com
CORS_ALLOW_CREDENTIALS=true

# ============================================
# SMS delivery (SMS Aero)
# ============================================
# Keep credentials in the local/deployment environment. Do not commit values.
SMS_PROVIDER=disabled
SMS_AERO_EMAIL=
SMS_AERO_API_KEY=
SMS_AERO_SIGN=SMS Aero
SMS_AERO_BASE_URL=
SMS_HTTP_TIMEOUT_SECONDS=10
ACCOUNT_AUTH_SMS_AUTOFILL_DOMAIN=pilot.restos.space
LEGACY_DEFAULT_ADMIN_BOOTSTRAP_ENABLED=false
ACCOUNT_GROUP_INVITATION_PEPPER=GENERATE_WITH: python -c "import secrets; print(secrets.token_hex(32))"
ACCOUNT_GROUP_ONBOARDING_DOB_LEGAL_PUBLISHED=false
TASK_MEDIA_PROVIDER=disabled

# ============================================
# WebAuthn / Passkeys
# ============================================
# RP ID is a hostname, not a URL. Replace both placeholders together.
WEBAUTHN_RP_ID=app.yourdomain.example
WEBAUTHN_RP_NAME=RestOS
WEBAUTHN_ALLOWED_ORIGINS=https://app.yourdomain.example
WEBAUTHN_CHALLENGE_TTL_SECONDS=300
WEBAUTHN_MAX_VERIFY_ATTEMPTS=3

# ============================================
# Webhook Configuration (if using webhooks)
# ============================================
WEBHOOK_URL=https://yourdomain.com
WEBHOOK_PATH=/webhook
WEBHOOK_SECRET=your_webhook_secret_here

# ============================================
# Monitoring & Logging (optional)
# ============================================
# SENTRY_DSN=https://your-sentry-dsn
# LOG_LEVEL=INFO
# ENABLE_METRICS=true

# ============================================
# Default Admin (created automatically on first startup)
# ============================================
# IMPORTANT: Change these before going to production!
DEFAULT_ADMIN_LOGIN=admin
DEFAULT_ADMIN_PASSWORD=CHANGE_THIS_STRONG_PASSWORD
DEFAULT_ADMIN_NAME=Главный администратор
DEFAULT_ORG_NAME=Название вашей организации
DEFAULT_ORG_CODE=main

# Internal API key (bot → API token endpoints)
INTERNAL_API_KEY=GENERATE_WITH: python -c "import secrets; print(secrets.token_hex(32))"

# JWT (веб-авторизация)
JWT_SECRET_KEY=GENERATE_WITH: python -c "import secrets; print(secrets.token_hex(32))"
JWT_EXPIRE_DAYS=30

# ============================================
# Google Sheets / Drive (наборы критериев)
# ============================================
# Путь к JSON сервисного аккаунта ИЛИ содержимое в GOOGLE_SERVICE_ACCOUNT_JSON_DATA
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SERVICE_ACCOUNT_JSON_DATA=
GOOGLE_SHEETS_FETCH_TIMEOUT=15
GOOGLE_SHEETS_MAX_ROWS=500
